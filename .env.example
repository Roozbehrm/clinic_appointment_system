# اصلی

# لوکال/دولوپمنت: clinic_appointment_system.settings.dev
# پروداکشن:       clinic_appointment_system.settings.production
# (برای اجرای تست‌ها لازم نیست همینجا ست بشه؛ pytest.ini خودش settings.test رو صدا می‌زنه)
DJANGO_SETTINGS_MODULE=clinic_appointment_system.settings.dev

# یک کلید تصادفی و طولانی بسازید، مثلاً با:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# دامنه‌ها/آی‌پی‌هایی که مجازند این سایت رو سرو کنن (با کاما جدا کنید)
# مثال پروداکشن: ALLOWED_HOSTS=clinic.example.com,www.clinic.example.com
# لوکال: نیازی نیست، dev.py خودش * می‌ذاره
ALLOWED_HOSTS=

# دامنه‌هایی که فرم‌های POST (CSRF) ازشون قبول می‌شه؛ باید با https:// نوشته بشه
# مثال: CSRF_TRUSTED_ORIGINS=https://clinic.example.com,https://www.clinic.example.com
CSRF_TRUSTED_ORIGINS=


# دیتابیس

# فقط در dev.py استفاده می‌شه: اگه True باشه از SQLite لوکال استفاده می‌کنه
# و بقیه‌ی DB_* رو نادیده می‌گیره. در production.py همیشه از Postgres
# استفاده می‌شه (این متغیر اونجا اصلاً خونده نمی‌شه).
USE_SQLITE=True

DB_NAME=clinic
DB_USER=clinic
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# ---------------------------------------------------------------------------
# ایمیل (تاییدیه‌ی رزرو، بازیابی رمز عبور، OTP از طریق ایمیل)
# ---------------------------------------------------------------------------
# اگه خالی بذارید، در dev.py ایمیل‌ها به‌جای ارسال واقعی توی کنسول چاپ می‌شن.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ---------------------------------------------------------------------------
# ورود با گوگل (django-allauth)
# ---------------------------------------------------------------------------
# Get these from Google Cloud Console.
# Redirect URI to register there:
# https://YOUR-DOMAIN/social-auth/google/login/callback/
# Replace YOUR-DOMAIN with your real domain.
# If you used a different prefix for allauth.urls in urls.py,
# use that prefix in the URI above.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# پیامک (کد یکبار مصرف / OTP)

# در dev.py پیش‌فرض کنسول است (پیامک چاپ می‌شه، ارسال واقعی نداره).
# در production.py پیش‌فرض kavenegar است؛ اگه سرویس دیگه‌ای دارید
# (مثلاً ملی‌پیامک)، می‌تونید override کنید:
# SMS_BACKEND=sms.backends.mellipayamak.MelliPayamakBackend
SMS_API_KEY=
SMS_SENDER_LINE=


# Redis / Celery (ارسال ناهمگام پیامک و ایمیل + پاک‌سازی دوره‌ای اسلات‌های منقضی)

# در docker-compose از سرویس redis استفاده می‌شه (redis://redis:6379/0)؛
# برای اجرای لوکال بدون داکر، به redis://localhost:6379/0 تغییرش بدید.
REDIS_URL=redis://redis:6379/0


# فقط پروداکشن (production.py می‌خونه‌شون؛ در dev لازم نیست)

SECURE_SSL_REDIRECT=True
# وضعیت فعلی: nginx
# فقط روی پورت 80 گوش می‌دهد و گواهی SSL ندارد
# خطر: SECURE_SSL_REDIRECT
# اگر True باشد و HTTPS هنوز راه‌اندازی نشده باشد
# جنگو مدام ریدایرکت می‌کند و سایت بالا نمی‌آید
# راه‌حل موقت تا نصب گواهی SSL
# مقدار زیر را False بگذارید
# SECURE_SSL_REDIRECT=False

SECURE_HSTS_SECONDS=2592000
